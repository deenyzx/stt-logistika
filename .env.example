# Copy to .env.local for local development. On Vercel, set these in Project → Settings → Environment Variables.
# Generate secrets with: openssl rand -hex 24

# The main admin login. This account always works (you can't lock yourself out).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_NAME=Din

# Signs the login cookie. Changing it logs everyone out.
SESSION_SECRET=

# WooCommerce → Settings → Advanced → Webhooks: the same secret, URL https://<domain>/api/integrations/woocommerce
WOO_WEBHOOK_SECRET=

# Order emails are posted to https://<domain>/api/integrations/email/<EMAIL_INBOUND_SECRET> (at least 16 characters)
EMAIL_INBOUND_SECRET=

# Token the office agent (agent/eki_sync.py) sends with each CSV (at least 16 characters)
STOCK_AGENT_TOKEN=

# Morning reminder (vercel.json runs /api/cron/daily once a day; Vercel sends this secret). At least 16 characters.
CRON_SECRET=

# Push notifications on phones and desktops. Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@company.ba

# Shared storage. Added automatically when you connect "Upstash for Redis" from the Vercel Marketplace
# (either pair works). Without them the app keeps data in memory only and shows a warning.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
